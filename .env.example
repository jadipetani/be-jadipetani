# ============================
# Jadipetani Backend — Environment Variables
# ============================
# Salin file ini menjadi .env dan isi semua value
# JANGAN commit file .env ke Git!

# ============================
# APP
# ============================
NODE_ENV=development
PORT=5000

# ============================
# DATABASE (Supabase PostgreSQL)
# Dapatkan di: Supabase Dashboard → Settings → Database → Connection String (URI)
# ============================
DATABASE_URL=

# ============================
# JWT SECRETS
# Generate dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Jalankan 2 kali — satu untuk ACCESS, satu untuk REFRESH
# ============================
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ============================
# FRONTEND URL & CORS ORIGINS (dipisahkan koma untuk multiple domains)
# ============================
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=https://jadipetani.vercel.app,https://be-jadipetani-production.up.railway.app,http://localhost:5173,http://localhost:3000

# ============================
# SUPABASE (Storage & Database)
# Dapatkan di: Supabase Dashboard → Settings → API
# Gunakan "service_role" key (BUKAN anon key) agar bisa manage Storage
# ============================
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ============================
# GEMINI AI (AI Curriculum Generator & AI Summary)
# Dapatkan di: https://aistudio.google.com/apikey
# ============================
GEMINI_API_KEY=

# ============================
# MIDTRANS (Payment Gateway — Job Connector)
# Dapatkan di: Midtrans Dashboard → Settings → Access Keys
# Gunakan Sandbox keys untuk development
# ============================
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ============================
# RESEND (Email Transaksional)
# Dapatkan di: https://resend.com → API Keys
# ============================
RESEND_API_KEY=

# ============================
# SENTRY (Error Tracking — Opsional)
# Dapatkan di: Sentry Dashboard → Project Settings → Client Keys (DSN)
# Kosongkan jika belum setup
# ============================
SENTRY_DSN=
